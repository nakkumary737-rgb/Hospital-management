rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Facilities
    match /facilities/{facilityId} {
      allow read, write: if true;
    }

    // Patients
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Cards
    match /cards/{cardId} {
      allow read, write: if true;
    }

    // Packages
    match /packages/{packageId} {
      allow read, write: if true;
    }

    // Memberships
    match /memberships/{membershipId} {
      allow read, write: if true;
    }

    // Family Members
    match /familyMembers/{familyMemberId} {
      allow read, write: if true;
    }

    // Chronic Programs
    match /chronicPrograms/{programId} {
      allow read, write: if true;
    }

    // Chronic Memberships
    match /chronicMemberships/{chronicId} {
      allow read, write: if true;
    }

    // Sickle Cell Profiles (Purely clinical)
    match /sickleCellProfiles/{profileId} {
      allow read, write: if true;
    }

    // Inventory Items (POS / Medication / Consumables)
    match /inventoryItems/{itemId} {
      allow read, write: if true;
    }
    match /inventory/{itemId} {
      allow read, write: if true;
    }

    // Visits
    match /visits/{visitId} {
      allow read, write: if true;
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Receipts
    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    // Authorizations
    match /authorizations/{authId} {
      allow read, write: if true;
    }

    // Claims
    match /claims/{claimId} {
      allow read, write: if true;
    }

    // Settlements
    match /settlements/{settlementId} {
      allow read, write: if true;
    }

    // Audit logs (append only, immutable)
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
